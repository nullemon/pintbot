# Local-only development defaults. Change these before exposing the stack.
POSTGRES_PASSWORD=bountyscope-local-only
API_TOKEN=local-development-change-me
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MAX_ROUNDS=3
AI_MAX_ACTIONS_PER_ROUND=20
# Autopilot uses scan budgets rather than AI_MAX_ROUNDS. Allowed range: 1-10.
# Stop after consecutive rounds without fresh completed checks returning responses.
AI_AUTOPILOT_NO_PROGRESS_ROUNDS=3
AI_LIVE_INTERVAL_SECONDS=30
AI_LIVE_MAX_FINDINGS=20
EVIDENCE_RETENTION_DAYS=30
USER_AGENT=BountyScope-SecurityScanner/1.0
