# NOTE: You can now set your Pinterest keys AND the admin password from the
# dashboard's ⚙ Settings tab (stored in the database). This .env is optional —
# values here are just the initial fallback. The one thing you must set here is
# ADMIN_PORT (where the dashboard listens) and the first-login ADMIN_PASSWORD.

# Pinterest app credentials (optional — can be set in the Settings tab instead)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8787/oauth/callback

# Admin panel — log in the first time (username: anything, password below),
# then change the password in the Settings tab.
ADMIN_PORT=8787
ADMIN_PASSWORD=admin

# Storage
DB_PATH=./data/bot.db
IMAGE_DIR=./data/images

# Drip pacing
PINS_PER_DAY=10
POST_INTERVAL_MINUTES=20

# Posting window (24h clock, local time). Pins only post within this window.
POST_WINDOW_START=8
POST_WINDOW_END=23

# Use Pinterest sandbox API instead of production (true/false)
PINTEREST_SANDBOX=false
