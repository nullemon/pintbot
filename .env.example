# Pinterest app credentials (from the Pinterest Developer portal)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8787/oauth/callback

# Admin panel
ADMIN_PORT=8787
ADMIN_PASSWORD=change-me

# Storage
DB_PATH=./data/bot.db
IMAGE_DIR=./data/images

# Drip pacing
PINS_PER_DAY=10
POST_INTERVAL_MINUTES=90

# Posting window (24h clock, local time). Pins only post within this window.
POST_WINDOW_START=8
POST_WINDOW_END=23

# Use Pinterest sandbox API instead of production (true/false)
PINTEREST_SANDBOX=false
